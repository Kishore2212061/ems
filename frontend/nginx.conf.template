# Rendered by the nginx image's envsubst at container start (${PORT}, ${BACKEND_URL}, ${NGINX_LOCAL_RESOLVERS}).
server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 1m;

    # Pre-compressed .gz files are produced at build time → zero CPU per request.
    gzip_static on;
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Resolve the backend at request time (Railway private DNS), not once at boot.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $backend ${BACKEND_URL};

    # Same-origin API: browser talks only to this host, so the refresh cookie stays first-party
    # (SameSite=Strict) and no CORS preflights are needed.
    location /api/ {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Content-hashed bundles: cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Posters (web-sized, fixed names): cache for a month; a missing file is a real 404, never the
    # SPA's index.html (which would make a broken image look like a 200).
    location /media/ {
        add_header Cache-Control "public, max-age=2592000";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # SPA fallback; index.html must always be revalidated so new deploys show up immediately.
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Permissions-Policy "camera=(self), geolocation=(self), microphone=()" always;
        try_files $uri /index.html;
    }
}
