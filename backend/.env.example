# Copy to .env for local dev. Real values live in Railway service variables.
NODE_ENV=development            # development | staging | production
PORT=4000
# Proxy hops in front of the API: 1 locally, 2 on Railway (edge + nginx)
TRUST_PROXY_HOPS=1
WEB_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/ems?retryWrites=true&w=majority
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d
# Revoked refresh tokens auto-delete after this (reuse-detection window)
REFRESH_REVOKED_RETENTION=1d
# Rotate the refresh token at most this often (reloads in between reuse it)
REFRESH_ROTATE_AFTER=1h
PASSWORD_PEPPER=

OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_WINDOW=3
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# resend | smtp | console (console = print emails to logs, dev only)
EMAIL_PROVIDER=console
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=NEC Events
EMAIL_REPLY_TO=

SEED_ORG_NAME=National Engineering College
SEED_ORG_SLUG=nec
SEED_TIMEZONE=Asia/Kolkata
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=Super Admin

# Optional, local only: override Node DNS if Atlas SRV lookup fails (querySrv ECONNREFUSED)
# DNS_SERVERS=8.8.8.8,1.1.1.1
